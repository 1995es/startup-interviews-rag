# Copy to .env and fill in what you need. Values in .env override the shell.
# Empty values are treated as unset.

# --- Transcription (prepare.py) ---

# Hugging Face token for speaker diarization. You must also accept the terms of
# pyannote/speaker-diarization-3.1 on huggingface.co with the same account.
# Without it the audio is still transcribed, all as SPEAKER_00.
HF_TOKEN=

# --- LLM segmentation (segment.py) ---

# anthropic (default) | openrouter. Overridden by --provider.
LLM_PROVIDER=anthropic

# Model id for the chosen provider. Overridden by --model. Leave empty for the
# provider's default: claude-opus-5-5 (anthropic) or anthropic/claude-opus-5-5
# (openrouter).
LLM_MODEL=

# Only the key of the chosen provider is required.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
